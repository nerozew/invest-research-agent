# ============================================
# 配置示例文件（P00-05）
# 复制为 .env 后填写真实值：
#   cp .env.example .env
# 真实 .env 已被 .gitignore 忽略，绝不提交。
# 本文件只含占位符，禁止放入真实密钥。
# ============================================

# ---- 运行环境 ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- LLM（OpenAI-compatible，供应商无关；默认阿里云百炼 qwen-max）----
# 任何 OpenAI-compatible 提供商都可通过环境变量切换，无需改代码：
#   阿里云百炼   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   专属 workspace LLM_BASE_URL=https://your-workspace-endpoint/compatible-mode/v1
#   DeepSeek     LLM_BASE_URL=https://api.deepseek.com  +  LLM_MODEL_*=deepseek-chat
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-alibaba-model-studio-api-key-here
LLM_MODEL_RESEARCH=qwen-max
LLM_MODEL_ANALYSIS=qwen-max
LLM_MODEL_WRITER=qwen-max
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60.0

# ---- SEC EDGAR 合规（User-Agent 必须含联系邮箱）----
SEC_USER_AGENT_CONTACT=your-email@example.com

# ---- 基础设施（可选，本地开发默认值见 settings.py）----
DATABASE_URL=postgresql+psycopg://invest:invest@localhost:5432/invest
REDIS_URL=redis://localhost:6379/0
ARTIFACT_ROOT=artifacts

# ---- HTTP 客户端（P02-02：显式连接/读取超时，User-Agent 含联系邮箱）----
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=30.0
HTTP_USER_AGENT=invest-research/0.1 (+your-email@example.com)

# ---- SEC 限流（P02-03：项目安全上限 5 req/s，低于官方 10 req/s）----
SEC_RATE_LIMIT_PER_SECOND=5.0
