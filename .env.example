# ============================================
# 配置示例文件（P00-05）
# 复制为 .env 后填写真实值：
#   cp .env.example .env
# 真实 .env 已被 .gitignore 忽略，绝不提交。
# 本文件只含占位符，禁止放入真实密钥。
# ============================================

# ---- 运行环境 ----
ENVIRONMENT=development
LOG_LEVEL=INFO
# Flow 运行模式（P05-12A）：fake=离线确定性（默认，不调用模型/不产生费用）；live=真实模型（需 LLM_API_KEY）
FLOW_MODE=fake
# 研究档位（P05.5）：fast=低预算快速运行；deep=完整投研能力（默认，向后兼容）
# fast 建议：LLM_MODEL_RESEARCH / LLM_MODEL_ANALYSIS 用快速模型，LLM_MODEL_WRITER 用高质量模型
RESEARCH_PROFILE=deep

# ---- LLM（OpenAI-compatible，供应商无关；默认阿里云百炼 qwen-max）----
# 任何 OpenAI-compatible 提供商都可通过环境变量切换，无需改代码：
#   阿里云百炼   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   专属 workspace LLM_BASE_URL=https://your-workspace-endpoint/compatible-mode/v1
#   DeepSeek     LLM_BASE_URL=https://api.deepseek.com  +  LLM_MODEL_*=deepseek-chat
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-alibaba-model-studio-api-key-here
LLM_MODEL_RESEARCH=qwen-max
LLM_MODEL_ANALYSIS=qwen-max
LLM_MODEL_WRITER=qwen-max
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60.0

# ---- SEC EDGAR 合规（User-Agent 必须含联系邮箱）----
SEC_USER_AGENT_CONTACT=your-email@example.com

# ---- 搜索服务（P02-18 Serper；P05-12B live 模式需要真实值）----
# 缺省时 FLOW_MODE=live 会 fail-fast，禁止自动退回 fake。
SERPER_API_KEY=your-serper-api-key-placeholder
SERPER_ENDPOINT=https://google.serper.dev/search

# ---- 基础设施（可选，本地开发默认值见 settings.py）----
DATABASE_URL=postgresql+psycopg://invest:invest@localhost:5432/invest
REDIS_URL=redis://localhost:6379/0
ARTIFACT_ROOT=artifacts

# ---- Readiness 探测超时（P04-01，可选）----
# /readiness 对依赖的探测超时（秒），默认 2.0
READINESS_DB_CONNECT_TIMEOUT=2.0
READINESS_REDIS_CONNECT_TIMEOUT=2.0

# ---- HTTP 客户端（P02-02：显式连接/读取超时，User-Agent 含联系邮箱）----
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=30.0
HTTP_USER_AGENT=invest-research/0.1 (+your-email@example.com)

# ---- SEC 限流（P02-03：项目安全上限 5 req/s，低于官方 10 req/s）----
SEC_RATE_LIMIT_PER_SECOND=5.0

# ---- Streamlit 前端（P04-UI-01：API Base URL 通过环境变量配置）----
# FastAPI 服务地址。本地开发默认值；Docker Compose 内使用服务名。
API_BASE_URL=http://localhost:8000
# 前端 HTTP client 的请求总超时（秒），显式设置避免无限等待。
API_TIMEOUT=30.0
