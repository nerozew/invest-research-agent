# ============================================
# 配置示例文件（P00-05）
# 复制为 .env 后填写真实值：
#   cp .env.example .env
# 真实 .env 已被 .gitignore 忽略，绝不提交。
# 本文件只含占位符，禁止放入真实密钥。
# ============================================

# ---- 运行环境 ----
# development：本地开发（允许占位符密钥，便于快速启动演示）；
# production：生产配置，配置对象会在启动时 fail-fast 校验——LLM_API_KEY /
# SERPER_API_KEY / SEC_USER_AGENT_CONTACT 仍为占位符时直接报错，绝不带占位符跑生产。
ENVIRONMENT=development
LOG_LEVEL=INFO
# Flow 运行模式（P05-12A）：fake=离线确定性（默认，不调用模型/不产生费用）；live=真实模型（需 LLM_API_KEY）
FLOW_MODE=fake
# 研究档位（P05.5）：fast=低预算快速运行；deep=完整投研能力（默认，向后兼容）
# fast 建议：LLM_MODEL_RESEARCH / LLM_MODEL_ANALYSIS 用快速模型，LLM_MODEL_WRITER 用高质量模型
RESEARCH_PROFILE=deep

# ---- LLM（OpenAI-compatible，供应商无关；默认阿里云百炼 qwen-max）----
# LLM_VENDOR（P06-11）显式标记具体供应商（qwen/deepseek/generic），决定 thinking
# 参数的供应商专用格式；generic=不传任何供应商专用参数。
#
# Qwen（阿里云百炼）示例：
#   LLM_VENDOR=qwen
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL_RESEARCH=qwen-max
#   LLM_MODEL_ANALYSIS=qwen-max
#   LLM_MODEL_WRITER=qwen-max
#   LLM_API_KEY=your-alibaba-model-studio-api-key-here
#
# DeepSeek 示例：
#   LLM_VENDOR=deepseek
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL_RESEARCH=deepseek-v4-flash
#   LLM_MODEL_ANALYSIS=deepseek-v4-flash
#   LLM_MODEL_WRITER=deepseek-v4-flash
#   LLM_API_KEY=your-deepseek-api-key-here
#
# 专属 workspace：LLM_VENDOR=generic（不传供应商专用参数）+ 自定义 LLM_BASE_URL。
# 安全（P06-04）：密钥只从环境变量/.env 读取，绝不写入代码、日志、工件或 manifest；
# 本文件只放占位符，真实 .env 已被 .gitignore 忽略，绝不提交。
LLM_PROVIDER=openai_compatible
LLM_VENDOR=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-alibaba-model-studio-api-key-here
LLM_MODEL_RESEARCH=qwen-max
LLM_MODEL_ANALYSIS=qwen-max
LLM_MODEL_WRITER=qwen-max
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60.0
# 思考模式（Qwen3.5 默认开启，响应极慢易超时）：false=显式关闭；true=显式开启；
# 缺省=不传供应商专有参数。DeepSeek 下自动翻译为 thinking.type=enabled/disabled
# （不需要时保持缺省即可使用 DeepSeek 默认行为）。
LLM_ENABLE_THINKING=false
# 可选：三个角色独立覆盖全局思考开关；只配置开关即可继承全局模型和密钥。
LLM_RESEARCH_ENABLE_THINKING=false
LLM_ANALYSIS_ENABLE_THINKING=false # 财务分析为确定性指标解读，开启 deepseek thinking 会耗尽 max_tokens 导致空输出
LLM_WRITER_ENABLE_THINKING=false

# ---- SEC EDGAR 合规（User-Agent 必须含联系邮箱）----
SEC_USER_AGENT_CONTACT=your-email@example.com

# ---- 搜索服务（P02-18 Serper；P05-12B live 模式需要真实值）----
# 缺省时 FLOW_MODE=live 会 fail-fast，禁止自动退回 fake。
SERPER_API_KEY=your-serper-api-key-placeholder
SERPER_ENDPOINT=https://google.serper.dev/search

# ---- 基础设施（可选，本地开发默认值见 settings.py）----
DATABASE_URL=postgresql+psycopg://invest:invest@localhost:5432/invest
REDIS_URL=redis://localhost:6379/0
ARTIFACT_ROOT=artifacts

# ---- Readiness 探测超时（P04-01，可选）----
# /readiness 对依赖的探测超时（秒），默认 2.0
READINESS_DB_CONNECT_TIMEOUT=2.0
READINESS_REDIS_CONNECT_TIMEOUT=2.0

# ---- HTTP 客户端（P02-02：显式连接/读取超时，User-Agent 含联系邮箱）----
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=30.0
HTTP_USER_AGENT=invest-research/0.1 (+your-email@example.com)

# ---- SEC 限流（P02-03：项目安全上限 5 req/s，低于官方 10 req/s）----
SEC_RATE_LIMIT_PER_SECOND=5.0

# ---- OpenTelemetry（P06-05：本地链路查看）----
# 配置 OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 后，API/Worker 的
# trace（api.request → worker.process → flow.run → tool.*）会批量导出到本地
# collector（deploy/otel-collector.yaml）；缺省为控制台导出（直接看 stdout）。
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=invest-research

# ---- Streamlit 前端（P04-UI-01：API Base URL 通过环境变量配置）----
# FastAPI 服务地址。本地开发默认值；Docker Compose 内使用服务名。
API_BASE_URL=http://localhost:8000
# 前端 HTTP client 的请求总超时（秒），显式设置避免无限等待。
API_TIMEOUT=30.0

# ---- P06-11K：失败任务 Payload 级诊断包（默认完全关闭）----
# DIAGNOSTIC_CAPTURE_MODE 可选值：
#   off             完全关闭（默认值，不产生任何诊断事件）
#   metadata        只保存长度/类型/hash/状态，不保存 Payload 内容
#   failure_payload 运行中放入 Job-local 内存缓冲区，仅任务失败时把脱敏
#                   Payload 落盘（成功任务丢弃 Payload）
#   all_payload     本地调试专用，成功和失败都落盘；生产环境（ENVIRONMENT=
#                   production）配置为 all_payload 会 fail-fast。
# 注意：诊断包可能包含业务输入，仅供本地调试；不要把完整 Payload 写入
# Jaeger、Prometheus label 或普通日志。reasoning_content/API Key/
# Authorization/Cookie 永远不保存。
DIAGNOSTIC_CAPTURE_MODE=off
# 单条诊断事件序列化后的字节上限；超出则截断 Payload 并置 truncated=true。
DIAGNOSTIC_MAX_EVENT_BYTES=65536
# 整个诊断 Bundle 的总字节上限；超出后拒绝新事件（累计 over_budget_events）。
DIAGNOSTIC_MAX_BUNDLE_BYTES=4194304
# Job-local Ring Buffer 最大事件数；超出丢弃最旧事件（累计 dropped_events）。
DIAGNOSTIC_MAX_EVENTS=200
# 诊断包保留天数；生命周期清理按此删除过期诊断包。
DIAGNOSTIC_RETENTION_DAYS=7

# WS3 成本估算单价文件（deploy/pricing.json；worker 容器内由 compose 覆盖为 /app/pricing.json）
PRICING_FILE=deploy/pricing.json
