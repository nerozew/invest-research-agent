# ============================================
# 配置示例文件（P00-05）
# 复制为 .env 后填写真实值：
#   cp .env.example .env
# 真实 .env 已被 .gitignore 忽略，绝不提交。
# 本文件只含占位符，禁止放入真实密钥。
# ============================================

# ---- 运行环境 ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- LLM（DeepSeek，OpenAI-compatible endpoint）----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-deepseek-api-key-here
LLM_MODEL_RESEARCH=deepseek-chat
LLM_MODEL_ANALYSIS=deepseek-chat
LLM_MODEL_WRITER=deepseek-chat

# ---- SEC EDGAR 合规（User-Agent 必须含联系邮箱）----
SEC_USER_AGENT_CONTACT=your-email@example.com

# ---- 基础设施（可选，本地开发默认值见 settings.py）----
DATABASE_URL=postgresql+psycopg://invest:invest@localhost:5432/invest
REDIS_URL=redis://localhost:6379/0
ARTIFACT_ROOT=artifacts

# ---- HTTP 客户端（P02-02：显式连接/读取超时，User-Agent 含联系邮箱）----
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=30.0
HTTP_USER_AGENT=invest-research/0.1 (+your-email@example.com)

# ---- SEC 限流（P02-03：项目安全上限 5 req/s，低于官方 10 req/s）----
SEC_RATE_LIMIT_PER_SECOND=5.0
